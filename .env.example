# Postgres (used by docker-compose to create the db container)
POSTGRES_USER=izavet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=izavet
POSTGRES_PORT=5432

# API (used by docker-compose when running the api container)
API_PORT=3000
NODE_ENV=development

# App DB connection (read directly by the Nest app via @nestjs/config).
# Use "localhost" when running the API with npm outside Docker.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=izavet
DB_PASSWORD=change-me
DB_NAME=izavet
